---
import CornerFrame from './CornerFrame.astro';
import GlyphStrip from './GlyphStrip.astro';
import RightRail from './RightRail.astro';
import PaneTransition from './PaneTransition.astro';
import AboutPane from './panes/AboutPane.astro';
import ResumePane from './panes/ResumePane.astro';
import { getBuildMeta } from '../lib/buildMeta';

interface Props {
  initialPane: 'about' | 'resume';
}
const { initialPane } = Astro.props;
const meta = getBuildMeta();

const sector = initialPane === 'about' ? '01' : '02';
---

<section class="hero glyph-grid" data-hero data-initial-pane={initialPane}>
  <CornerFrame
    inset={18}
    targets={{
      tl: '[data-cf-text="top-l"]',
      tr: '[data-cf-text="top-r"]',
      bl: '[data-cf-text="meta-bar"]',
      br: '[data-cf-text="name-block"]',
    }}
  >
    <div class="hero-inner">
      <div class="top-l" data-cf-text="top-l" data-i18n="hero.sys">// PORTFOLIO.SYS — REV 2026.05</div>

      <div class="top-r" data-cf-text="top-r">
        <div class="commit-line">
          <b>{meta.shortHash}</b><span data-i18n="hero.commit">LATEST COMMIT</span>
          {meta.subject && <span class="commit-sub" title={meta.subject}>"{meta.subject}"</span>}
        </div>
      </div>

      <div class="glyphs">
        <GlyphStrip direction="v" count={22} gap={18} glitch stretch />
      </div>

      <div class="pane-container" data-pane-container>
        <PaneTransition />
        <div class="pane-frame" data-pane-frame>
          <div class="pane-slot" data-pane-slot="about" data-active={initialPane === 'about' ? 'true' : 'false'} aria-hidden={initialPane !== 'about'}>
            <AboutPane />
          </div>
          <div class="pane-slot" data-pane-slot="resume" data-active={initialPane === 'resume' ? 'true' : 'false'} aria-hidden={initialPane !== 'resume'}>
            <ResumePane />
          </div>
        </div>
      </div>

      <RightRail activeKey={initialPane} />

      <div class="name-block" data-cf-text="name-block">
        <div class="kicker">— <span data-i18n="hero.role">STAFF AI ENGINEER</span> · <a class="kicker-link" href="https://lilt.com" target="_blank" rel="noopener noreferrer" aria-label="LILT AI — lilt.com">LILT AI</a></div>
        <h1 class="name name-glitch">
          <span class="name-en">CHARLIE SHI</span>
          <span class="name-zh" lang="zh">石千里</span>
        </h1>
      </div>

      <div class="meta-rail">
        <GlyphStrip direction="h" count={42} gap={10} glitch stretch />
      </div>

      <div class="meta-bar" data-cf-text="meta-bar">
        <span class="meta-coords" data-i18n="meta.loc">↳ BOSTON, MA</span>
        <span class="meta-sep">·</span>
        <a
          class="meta-coords-val"
          href="https://www.google.com/maps/search/?api=1&query=42.3601%2C-71.0589"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open Boston, MA in Google Maps"
        >N 42°21′ W 71°03′</a>
        <span class="sp"></span>
        <a class="meta-cta" href={initialPane === 'about' ? '#about' : '/resume.pdf'} data-cta-href data-i18n={initialPane === 'about' ? 'meta.enter' : 'meta.download'}>
          {initialPane === 'about' ? '↗ ENTER' : '↗ DOWNLOAD PDF'}
        </a>
      </div>
    </div>
  </CornerFrame>
</section>

<style>
  .hero {
    position: relative;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }
  .hero :global(.cf) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-inner {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .top-l, .top-r {
    position: absolute;
    top: 18px;
    height: 22px;
    display: flex;
    align-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }
  .top-l { left: 60px; color: var(--accent-yellow); }
  .top-r { right: 60px; text-align: right; }
  .top-r .commit-line {
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    white-space: nowrap;
  }
  .top-r .commit-line b { color: var(--accent-blue); font-weight: 700; margin-right: 6px; }
  .top-r .commit-sub {
    font-size: 9px;
    color: #6a6a6e;
    letter-spacing: 0.1em;
    max-width: 280px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-transform: none;
  }

  .glyphs {
    position: absolute;
    top: 48px;
    bottom: 48px;
    left: 26px;
    display: flex;
    align-items: stretch;
    justify-content: center;
  }
  .glyphs :global(.gs) {
    height: 100%;
    justify-content: space-between;
  }

  .pane-container {
    position: absolute;
    top: 140px;
    bottom: 296px;
    left: 130px;
    right: 300px;
  }
  .pane-frame {
    position: relative;
    width: 100%;
    height: 100%;
    border: 1px dashed #3a3a3e;
    padding: 22px 28px;
    background: rgba(10,10,10,0.55);
    overflow: hidden;
  }
  .pane-slot {
    position: absolute;
    inset: 22px 28px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms;
  }
  .pane-slot[data-active="true"] {
    opacity: 1;
    pointer-events: auto;
  }

  .name-block {
    position: absolute;
    left: 60px;
    bottom: 96px;
    max-width: 70%;
  }
  .kicker {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 14px;
  }
  .kicker .kicker-link {
    color: var(--accent-yellow);
    text-decoration: none;
    transition: opacity 200ms;
  }
  .kicker .kicker-link:hover {
    opacity: 0.7;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  :global(.cf-hidden) {
    visibility: hidden;
  }
  .name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 800;
    letter-spacing: 0.04em;
    font-size: clamp(56px, 8.5vw, 96px);
    line-height: 0.9;
    color: var(--text-primary);
    text-transform: uppercase;
    margin: 0;
    white-space: nowrap;
  }
  .name .name-zh {
    font-size: clamp(56px, 8.5vw, 96px);
    letter-spacing: 0.06em;
  }

  .meta-bar {
    position: absolute;
    bottom: 18px;
    height: 22px;
    left: 60px; right: 60px;
    display: flex;
    gap: 18px;
    align-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .meta-rail {
    position: absolute;
    left: 40px; right: 40px;
    bottom: 61px;
    height: 14px;
    display: flex;
    align-items: center;
  }
  .meta-bar .meta-coords { color: var(--accent-yellow); }
  .meta-bar .meta-sep { color: var(--text-secondary); }
  .meta-bar .meta-coords-val {
    color: var(--accent-blue);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-decoration: none;
    transition: opacity 200ms;
  }
  .meta-bar .meta-coords-val:hover { opacity: 0.7; text-decoration: underline; text-underline-offset: 3px; }
  .meta-bar .sp { flex: 1; }
  .meta-bar .meta-cta {
    color: var(--accent-yellow);
    text-decoration: none;
    transition: opacity 200ms;
  }
  .meta-bar .meta-cta:hover { opacity: 0.7; }

  @media (max-width: 768px) {
    .top-l, .top-r { top: 13px; height: 14px; font-size: 9px; letter-spacing: 0.18em; }
    .top-l { left: 40px; }
    .top-r { right: 40px; }
    .top-r .commit-sub { display: none; }
    .top-r .commit-line span[data-i18n="hero.commit"] { display: none; }
    .top-r .commit-line b { margin-right: 0; }
    .glyphs { display: none; }
    .pane-container {
      top: 130px; bottom: 230px; left: 40px; right: 40px;
    }
    .pane-frame { padding: 14px 16px; }
    .pane-slot { inset: 14px 16px; }
    .name-block { left: 40px; bottom: 96px; max-width: 92%; }
    .name { font-size: 56px; white-space: nowrap; }
    .name .name-zh { font-size: 56px; }
    .kicker { font-size: 9px; margin-bottom: 10px; }
    .meta-bar { bottom: 13px; height: 14px; left: 40px; right: 40px; }
    .meta-rail { bottom: 56px; left: 32px; right: 32px; height: 12px; }
  }
</style>
