---
const stats = [
  { kKey: 'about.stat.years',    k: 'Years',    v: '11',             vKey: null,                       accent: 'blue'   },
  { kKey: 'about.stat.stack',    k: 'Stack',    v: 'TS · PY · JAVA', vKey: null,                       accent: 'yellow' },
  { kKey: 'about.stat.focus',    k: 'Focus',    v: 'AGENT · MCP',    vKey: 'about.stat.focus.v',       accent: 'yellow' },
  { kKey: 'about.stat.location', k: 'Location', v: 'ANDOVER, MA',    vKey: 'about.stat.location.v',    accent: 'yellow' },
  { kKey: 'about.stat.status',   k: 'Status',   v: 'BUILDING',       vKey: 'about.stat.status.v',      accent: 'blue'   },
];

const now = [
  { key: 'about.now.1', text: 'Agent-MCP orchestration @ LILT' },
  { key: 'about.now.2', text: 'ML infra · vLLM · eval harnesses' },
  { key: 'about.now.3', text: 'Personal · terminal-led site' },
];

const links = [
  { href: 'https://github.com/qcharlieshi',           label: 'GITHUB ↗',   i18n: 'about.link.github'   },
  { href: 'https://www.linkedin.com/in/qcharlieshi/', label: 'LINKEDIN ↗', i18n: 'about.link.linkedin' },
  { href: 'mailto:me@charlieshi.com',                 label: 'EMAIL ↗',    i18n: 'about.link.email'    },
];
---

<div class="pane" data-pane-key="about">
  <div class="pane-label" data-i18n="about.label">// ABOUT</div>

  <div class="pane-body">
    <div class="col-main">
      <p class="prose" data-i18n-html="about.prose">
        Building <code>Agent-MCP</code> orchestration and ML infrastructure at
        <a href="https://lilt.com" target="_blank" rel="noopener">LILT</a>.
        Boston native, currently in Andover, MA. Heavy bias toward shipping;
        allergic to abstractions that don't pay for themselves. Background spans
        fullstack ↗ ML infra ↗ agent platforms.
      </p>

      <div class="sub-section">
        <h4 class="section-h" data-i18n="about.now">// NOW</h4>
        <ul class="bullet-list">
          {now.map((n) => <li><span data-i18n={n.key}>{n.text}</span></li>)}
        </ul>
      </div>
    </div>

    <div class="col-side">
      {stats.map((s) => (
        <div class="stat">
          <div class="stat-k">// <span data-i18n={s.kKey}>{s.k}</span></div>
          {s.vKey
            ? <div class:list={['stat-v', s.accent]}><span data-i18n={s.vKey}>{s.v}</span></div>
            : <div class:list={['stat-v', s.accent]}>{s.v}</div>}
        </div>
      ))}
    </div>
  </div>

  <div class="pane-footer">
    {links.map((l) => (
      <a class="tag" href={l.href} target="_blank" rel="noopener">[ <span data-i18n={l.i18n}>{l.label}</span> ]</a>
    ))}
  </div>
</div>

<style>
  .pane {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    overflow: hidden;
  }
  .pane-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--accent-yellow);
    flex-shrink: 0;
  }

  .pane-body {
    display: flex;
    gap: 28px;
    flex: 1;
    min-height: 0;
  }

  .col-main {
    flex: 1;
    min-width: 0;
    overflow-y: auto;
    padding-right: 8px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .col-side {
    width: 190px;
    flex-shrink: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-left: 1px dashed var(--border);
    padding-left: 18px;
  }
  .col-main::-webkit-scrollbar,
  .col-side::-webkit-scrollbar { width: 6px; }
  .col-main::-webkit-scrollbar-track,
  .col-side::-webkit-scrollbar-track { background: transparent; }
  .col-main::-webkit-scrollbar-thumb,
  .col-side::-webkit-scrollbar-thumb { background: var(--accent-yellow); }

  .prose {
    color: #c8c8ce;
    font-size: 14px;
    line-height: 1.65;
    margin: 0;
  }
  /* `:global` so the runtime i18n innerHTML swap keeps the styling. */
  .prose :global(a) {
    color: var(--accent-blue);
    text-decoration: none;
    border-bottom: 1px solid rgba(24,96,255,0.55);
  }
  .prose :global(code) {
    color: var(--accent-blue);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
  }

  .sub-section { display: flex; flex-direction: column; gap: 8px; }
  .section-h {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 0.22em;
    color: var(--accent-yellow);
    margin: 0; font-weight: 500;
  }
  .bullet-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    line-height: 1.5;
    color: #c8c8ce;
  }
  .bullet-list li::before {
    content: '↳ ';
    color: var(--accent-yellow);
  }

  .stat { border-top: 1px solid var(--border); padding-top: 6px; }
  .stat-k {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 0.18em;
    color: var(--text-secondary);
  }
  .stat-v {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px; margin-top: 4px;
    color: var(--accent-yellow);
  }
  .stat-v.blue { color: var(--accent-blue); }

  .pane-footer {
    flex-shrink: 0;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    border-top: 1px dashed var(--border);
    padding-top: 12px;
  }
  .tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 0.18em;
    color: var(--accent-yellow);
    padding: 3px 10px;
    border: 1px solid var(--accent-yellow);
    text-decoration: none;
    transition: background 200ms;
  }
  .tag:hover { background: rgba(255,210,63,0.08); }

  @media (max-width: 720px) {
    .pane-body { flex-direction: column; gap: 16px; }
    .col-main { padding-right: 0; }
    .col-side {
      width: auto;
      border-left: 0;
      padding-left: 0;
      border-top: 1px dashed var(--border);
      padding-top: 14px;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 18px;
      overflow-y: visible;
    }
    .col-side .stat { min-width: 90px; border-top: 0; padding-top: 0; }
    .prose { font-size: 12px; }
    .tag { font-size: 9px; padding: 2px 6px; }
  }
</style>
